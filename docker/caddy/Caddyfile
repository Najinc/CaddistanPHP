{$DOMAIN} {
    tls internal
    encode zstd gzip

    root * /var/www/public

    # En-têtes de sécurité des fichiers statiques (/dist, /images…), qui ne passent pas par PHP.
    # "?" = valeur par défaut : les réponses PHP gardent les leurs (App\Core\SecurityHeaders,
    # dont la CSP avec nonce, différente à chaque requête).
    header {
        ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Un fichier statique ouvert directement (ex : un SVG) ne peut rien charger ni exécuter
        ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
        ?X-Frame-Options "DENY"
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Upload : un corps de requête trop gros est coupé ici, avant PHP (un tar.gz de 1 Go ne va pas plus loin).
    # Sous le post_max_size de PHP (10M) : au-delà, PHP vide le formulaire et affiche un warning.
    # La limite des images (2 Mo) reste vérifiée dans ProductImageService.
    request_body {
        max_size 8MB
    }

    handle_errors 413 {
        respond "Fichier trop lourd : 2 Mo maximum pour une image." 413
    }

    respond /hot 404

    # Websocket Vite (HMR)
    @vite_ws header Upgrade websocket
    handle @vite_ws {
        reverse_proxy vite:{$VITE_PORT}
    }

    @vite_assets path /@vite/* /@id/* /@fs/* /resources/* /node_modules/* /src/*
    handle @vite_assets {
        reverse_proxy vite:{$VITE_PORT}
    }

    handle {
        # Port par défaut PHP-FPM
        php_fastcgi app:9000
        file_server
    }
}