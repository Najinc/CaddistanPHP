{$DOMAIN} {
    tls internal
    encode zstd gzip

    root * /var/www/public

    # En-têtes de sécurité des fichiers statiques (/dist, /images…), qui ne passent pas par PHP.
    # "?" = valeur par défaut : les réponses PHP gardent les leurs (App\Core\SecurityHeaders,
    # dont la CSP avec nonce, différente à chaque requête).
    header {
        ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Un fichier statique ouvert directement (ex : un SVG) ne peut rien charger ni exécuter
        ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
        ?X-Frame-Options "DENY"
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "strict-origin-when-cross-origin"
    }

    respond /hot 404

    # Websocket Vite (HMR)
    @vite_ws header Upgrade websocket
    handle @vite_ws {
        reverse_proxy vite:{$VITE_PORT}
    }

    @vite_assets path /@vite/* /@id/* /@fs/* /resources/* /node_modules/* /src/*
    handle @vite_assets {
        reverse_proxy vite:{$VITE_PORT}
    }

    handle {
        # Port par défaut PHP-FPM
        php_fastcgi app:9000
        file_server
    }
}